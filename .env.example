# Copy to .env (gitignored) and fill from Firebase console > Project settings > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check
# Web app: reCAPTCHA Enterprise site key (Firebase console > App Check > Apps > Web)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=6Ld-ETIuAAAAAAYd0TpnvOLoejvsuRi1YQuLMJqN
# ...or, if Enterprise asks for billing, a classic reCAPTCHA v3 site key instead
VITE_RECAPTCHA_V3_SITE_KEY=
# Debug token registered in Firebase console > App Check > Apps > (web app) > Manage debug tokens.
# Required for the Chrome extension (extensions cannot load reCAPTCHA). Optional for local web dev.
VITE_APPCHECK_DEBUG_TOKEN=
VITE_FIREBASE_MEASUREMENT_ID=